new file mode 100644
index 0000000..4a13c98
--- /dev/null
+++ b/include/key_cache.h
@@ -0,0 +1,30 @@
+#pragma once
+
+// EE04 (TRMNL 7.5" OG DIY Kit) key cache: the server's current image for each of
+// KEY1..KEY3 is kept on flash as /key1.png../key3.png, so a key press redraws its
+// screen straight away, before Wi-Fi is up. See README.md of trmnl-diy-kit-keys.
+
+#include <config.h>
+
+#ifdef XIAO_EPAPER_KEYS
+#include <api_types.h>
+#include <types.h>
+
+// Draws the cached image for `key` (1..3). False when there is none.
+bool key_cache_show(int key);
+
+// After /api/display: shows the current screen (from the cache when it is one of
+// key_images, downloading it first if it changed) and refreshes the other cached
+// screens. Returns false when the response is not for the key cache, and the
+// caller takes its usual path.
+bool key_cache_handle(const ApiDisplayResponse &response, const ApiDisplayInputs &inputs, https_request_err_e *result);
+
+// Keys only wake the device from deep sleep, and a key-cache redraw is quick, so
+// the next key is often pressed while the device is still talking to the server.
+// key_watch_start() latches such presses; key_watch_defer() (just before deep
+// sleep) turns one into an immediate wake-up, and key_watch_resume() (on that
+// wake-up) returns the key so it is handled like a normal key wake.
+void key_watch_start(void);
+bool key_watch_defer(void);
+int key_watch_resume(void);
+#endif
