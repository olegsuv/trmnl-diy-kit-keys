diff --git a/src/key_cache.cpp b/src/key_cache.cpp
new file mode 100644
index 0000000..1214c45
--- /dev/null
+++ b/src/key_cache.cpp
@@ -0,0 +1,164 @@
+#include <key_cache.h>
+
+#ifdef XIAO_EPAPER_KEYS
+#include <Preferences.h>
+#include <cinttypes>
+#include <api-client/request_headers.h>
+#include <display.h>
+#include <filesystem.h>
+#include <globals.h>
+#include <services/http_retry_request.h>
+#include <trmnl_log.h>
+
+#include "displayed_image.h"
+#include "driver/rtc_io.h"
+
+static const uint8_t PNG_SIGNATURE[8] = {0x89, 'P', 'N', 'G', 0x0d, 0x0a, 0x1a, 0x0a};
+
+// Which key's screen is on the panel; survives deep sleep, not a power cycle.
+RTC_DATA_ATTR static int shown_key = 0;
+// A key pressed while awake, to be handled right after the coming deep sleep.
+RTC_DATA_ATTR static int deferred_key = 0;
+static volatile int latched_key = 0;
+
+static String cache_path(int key) { return String("/key") + key + ".png"; }
+
+static String name_pref(int key) { return String("kc_name") + key; }
+
+// The server filename the cached file holds, in the SPIFFS-safe form DisplayedImage uses.
+static void fixed_name(const String &filename, char *out) { filesystem_fix_filename(filename.c_str(), out); }
+
+static bool draw_file(int key, const String &filename, bool switching) {
+  uint8_t *buf = nullptr;
+  size_t size = filesystem_read_and_allocate(cache_path(key).c_str(), &buf);
+  if (!buf || size < sizeof(PNG_SIGNATURE) || memcmp(buf, PNG_SIGNATURE, sizeof(PNG_SIGNATURE)) != 0) {
+    Log_info("Key cache: /key%d.png missing or unreadable", key);
+    if (buf) free(buf);
+    filesystem_file_delete(cache_path(key).c_str());
+    preferences.remove(name_pref(key).c_str());
+    return false;
+  }
+  // A different screen replaces everything on the panel; a partial update would
+  // leave the old one ghosted underneath, so that gets one quick flash instead.
+  prefer_fast_refresh = switching;
+  display_show_image(buf, size, true);
+  prefer_fast_refresh = false;
+  free(buf);
+  shown_key = key;
+  char szTemp[36];
+  fixed_name(filename, szTemp);
+  DisplayedImage::remember(szTemp);
+  return true;
+}
+
+bool key_cache_show(int key) {
+  String filename = preferences.getString(name_pref(key).c_str(), "");
+  if (filename.isEmpty() || !filesystem_file_exists(cache_path(key).c_str())) {
+    Log_info("Key cache: nothing cached for KEY%d", key);
+    key_cache_note = "miss";
+    return false;
+  }
+  char szTemp[36];
+  fixed_name(filename, szTemp);
+  if (DisplayedImage::matches(szTemp)) { // e.g. the same key twice
+    Log_info("Key cache: KEY%d is already on the panel", key);
+    key_cache_note = "same";
+    shown_key = key;
+    return true;
+  }
+  Log_info("Key cache: KEY%d -> %s from flash", key, filename.c_str());
+  // No API response yet this wake: keep the saved temperature profile as it is.
+  apiDisplayResult.response.temp_profile = iTempProfile;
+  bool drawn = draw_file(key, filename, true);
+  key_cache_note = drawn ? "hit" : "bad";
+  return drawn;
+}
+
+// Makes /key<key>.png hold `filename`, downloading it when it does not already.
+static bool ensure(int key, const String &filename, const String &url, const ApiDisplayInputs &inputs) {
+  if (preferences.getString(name_pref(key).c_str(), "") == filename && filesystem_file_exists(cache_path(key).c_str()))
+    return true;
+
+  HttpRetryRequestConfig config;
+  config.url = url;
+  config.apiBaseUrl = inputs.baseUrl; // ID / Access-Token only go to the API server
+  config.headers = buildImageHeaders(inputs);
+  HttpRetryRequest request(config);
+  https_request_err_e err = request.execute();
+  if (err != HTTPS_NO_ERR) {
+    Log_info("Key cache: KEY%d download failed - %s", key, https_request_err_str(err));
+    return false;
+  }
+  uint8_t *body = request.body();
+  uint32_t size = request.bodySize();
+  if (size < sizeof(PNG_SIGNATURE) || memcmp(body, PNG_SIGNATURE, sizeof(PNG_SIGNATURE)) != 0) {
+    Log_info("Key cache: KEY%d is not a PNG (%" PRIu32 " bytes), not cached", key, size);
+    return false;
+  }
+  if (filesystem_write_to_file(cache_path(key).c_str(), body, size) != size) {
+    Log_info("Key cache: writing /key%d.png failed", key);
+    filesystem_file_delete(cache_path(key).c_str());
+    preferences.remove(name_pref(key).c_str());
+    return false;
+  }
+  preferences.putString(name_pref(key).c_str(), filename);
+  Log_info("Key cache: KEY%d <- %s (%" PRIu32 " bytes)", key, filename.c_str(), size);
+  return true;
+}
+
+bool key_cache_handle(const ApiDisplayResponse &response, const ApiDisplayInputs &inputs, https_request_err_e *result) {
+  int current = 0;
+  for (int i = 0; i < 3; i++) {
+    if (response.key_filenames[i].length() > 0 && response.key_filenames[i] == response.filename) current = i + 1;
+  }
+  if (current == 0) return false; // stock server, or not one of the key screens
+
+  char szTemp[36];
+  fixed_name(response.filename, szTemp);
+  bool on_panel = DisplayedImage::matches(szTemp);
+
+  // The screen the device should show first, then the rest in the background.
+  if (!ensure(current, response.filename, response.key_urls[current - 1], inputs) && !on_panel) return false;
+  if (on_panel) {
+    Log_info("Key cache: %s is already on the panel", szTemp);
+  } else if (!draw_file(current, response.filename, shown_key != current)) { // another screen: a quick full refresh
+    return false;
+  }
+
+  for (int key = 1; key <= 3; key++) {
+    if (key == current || response.key_filenames[key - 1].isEmpty()) continue;
+    ensure(key, response.key_filenames[key - 1], response.key_urls[key - 1], inputs);
+  }
+  *result = HTTPS_SUCCESS;
+  return true;
+}
+
+static void IRAM_ATTR on_key1(void) { latched_key = 1; }
+static void IRAM_ATTR on_key2(void) { latched_key = 2; }
+static void IRAM_ATTR on_key3(void) { latched_key = 3; }
+
+void key_watch_start(void) {
+  const int pins[3] = {PIN_KEY1, PIN_KEY2, PIN_KEY3};
+  void (*handlers[3])(void) = {on_key1, on_key2, on_key3};
+  for (int i = 0; i < 3; i++) {
+    rtc_gpio_deinit((gpio_num_t)pins[i]); // ext1 left them as RTC pins
+    pinMode(pins[i], INPUT_PULLUP);
+    attachInterrupt(digitalPinToInterrupt(pins[i]), handlers[i], FALLING);
+  }
+}
+
+bool key_watch_defer(void) {
+  int key = latched_key;
+  // The key that woke the device bounces on release; its screen is already shown.
+  if (key == 0 || key == shown_key) return false;
+  Log_info("Key cache: KEY%d pressed while awake, handling it after a 1 ms sleep", key);
+  deferred_key = key;
+  return true;
+}
+
+int key_watch_resume(void) {
+  int key = deferred_key;
+  deferred_key = 0;
+  return key;
+}
+#endif
